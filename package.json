{
	"name": "comty.js",
	"version": "2.0.0",
	"description": "Official Comty API for JavaScript",
	"homepage": "https://github.com/ragestudio/comty.js",
	"author": "RageStudio <support@ragestudio.net>",
	"license": "MIT",
	"type": "module",
	"types": "./dist/index.d.ts",
	"main": "./dist/index.js",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js",
			"default": "./dist/index.js"
		},
		"./types": "./dist/types.js",
		"./client": "./dist/core/client.js",
		"./session": "./dist/core/session.js",
		"./storage/*": "./dist/core/storage/*.js",
		"./storage": "./dist/core/storage/index.js",
		"./remotes": "./dist/core/remotes.js",
		"./auth": "./dist/core/auth/index.js",
		"./auth/use": "./dist/core/auth/use.js",
		"./realtime": "./dist/core/realtime/index.js",
		"./endpoints/*": "./dist/endpoints/*/index.js",
		"./core/*": {
			"types": "./dist/core/*.d.ts",
			"default": "./dist/core/*.js"
		},
		"./hooks/*": "./dist/hooks/*/index.js",
		"./utils/*": "./dist/utils/*.js",
		"./package.json": "./package.json"
	},
	"scripts": {
		"build": "sh ./scripts/build.sh",
		"typecheck": "tsc --noEmit",
		"clean": "rm -rf dist",
		"test": "vitest run",
		"test:watch": "vitest"
	},
	"files": [
		"dist",
		"src",
		"package.json"
	],
	"publishConfig": {
		"access": "public"
	},
	"peerDependencies": {
		"react": "^19"
	},
	"dependencies": {
		"@comty/shared": "workspace:*",
		"@linebridge/client": "workspace:*",
		"axios": "^1.21.0",
		"js-cookie": "^3.0.8",
		"jwt-decode": "^4.0.0",
		"tseep": "^1.3.1",
		"valibot": "^1.4.2",
		"zustand": "^5.0.15"
	},
	"devDependencies": {
		"@types/js-cookie": "^3.0.6",
		"@types/node": "^26.4.0",
		"@types/react": "^19.3.0",
		"tsc-alias": "^1.9.9",
		"typescript": "^7.0.2",
		"vitest": "^4.1.11"
	}
}
